{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "XRAY_AI_PATH=${XRAY_AI_PATH:-node_modules/0xray} node ${XRAY_AI_PATH:-node_modules/0xray}/dist/integrations/grok/hooks/pre-tool-use.js",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "XRAY_AI_PATH=${XRAY_AI_PATH:-node_modules/0xray} node ${XRAY_AI_PATH:-node_modules/0xray}/dist/integrations/grok/hooks/session-start.js",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "XRAY_AI_PATH=${XRAY_AI_PATH:-node_modules/0xray} node ${XRAY_AI_PATH:-node_modules/0xray}/dist/integrations/grok/hooks/session-start.js --hook-event=user_prompt_submit",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "XRAY_AI_PATH=${XRAY_AI_PATH:-node_modules/0xray} node ${XRAY_AI_PATH:-node_modules/0xray}/dist/integrations/grok/hooks/post-tool-use.js",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
