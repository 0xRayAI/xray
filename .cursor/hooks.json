{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": ".cursor/hooks/pre-tool-use.sh",
        "failClosed": true
      }
    ],
    "preCompact": [
      {
        "command": ".cursor/hooks/pre-compact.sh"
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/after-file-edit.sh"
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/before-shell-execution.sh",
        "failClosed": true
      }
    ],
    "beforeReadFile": [
      {
        "command": ".cursor/hooks/before-read-file.sh",
        "failClosed": true
      }
    ],
    "sessionStart": [
      {
        "command": ".cursor/hooks/cloud-activity.sh",
        "timeout": 2
      }
    ],
    "postToolUse": [
      {
        "command": ".cursor/hooks/cloud-activity.sh",
        "timeout": 2
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/cloud-activity.sh",
        "timeout": 2
      }
    ]
  }
}
