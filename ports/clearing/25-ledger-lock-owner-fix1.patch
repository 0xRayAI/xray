+  return new Promise((resolve, reject) => {
+    const child = spawn(process.execPath, [tsx, worker, lock, log], {
+      cwd: dirname(worker),
+      env: { ...process.env, CLEARING_LEDGER_LOCK_STALE_MS: '1000' },
+    });
+    let err = '';
+    child.stderr.on('data', (chunk: Buffer) => {
+      err += chunk.toString();
