+function holderDepth(log: string): { max: number; enters: number; open: number } {
+  let open = 0;
+  let max = 0;
+  let enters = 0;
+  for (const line of log.split('\n')) {
+    if (line.startsWith('enter ')) {
+      open += 1;
+      enters += 1;
+      if (open > max) max = open;
+    } else if (line.startsWith('exit ')) {
+      open -= 1;
+    }
+  }
+  return { max, enters, open };
+}
