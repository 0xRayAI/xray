+        let token = self.token_id.clone();
+        ext_ft::ext(token.clone())
+            .with_attached_deposit(USDC_STORAGE_DEPOSIT)
+            .with_static_gas(GAS_STORAGE_DEPOSIT)
+            .storage_deposit(Some(caller.clone()), Some(true))
+            .then(
+                ext_ft::ext(token)
+                    .with_attached_deposit(ONE_YOCTO)
+                    .with_static_gas(GAS_FT_TRANSFER)
+                    .ft_transfer(caller.clone(), U128(amount), Some("escrow withdraw".to_string())),
+            )
+            .then(
+                ext_self::ext(env::current_account_id())
+                    .with_static_gas(GAS_ON_WITHDRAW)
+                    .on_withdraw(caller, U128(amount)),
+            )
+    }
