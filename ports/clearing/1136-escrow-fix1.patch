     /// Pay the caller's withdrawable balance out through `ft_transfer`.
+    /// The balance is held aside first. `on_withdraw` puts it back if that
+    /// promise fails, the same rule NEP-141 uses when `ft_resolve_transfer`
+    /// sees a failed call: the unused amount goes back to the sender.
+    /// https://nomicon.io/Standards/Tokens/FungibleToken/Core
+    /// Before the transfer, register the receiver (NEP-145 `storage_deposit`,
+    /// `registration_only`). Circle USDC rejects an unregistered receiver.
     pub fn withdraw(&mut self) -> Promise {
         let caller = env::predecessor_account_id();
         let amount = self.balances.get(&caller).copied().unwrap_or(0);
         require!(amount > 0, "nothing to withdraw");
         self.balances.insert(caller.clone(), 0);
-        ext_ft::ext(self.token_id.clone())
