+        creator_pk: [1u8; 32],
+        client_pk: [2u8; 32],
+        fee_bps: 0,
+        fee_amount: 0,
+        delivery_duration_ns: DURATION,
+        delivery_deadline_ns: Some(DEADLINE),
+        review_period_ns: REVIEW,
+        pay_by_ns: T0 + PAY_BY,
+        funded_at_ns: Some(FUNDED_AT),
+        delivered_at_ns: None,
+        deliverable_hash: None,
+        terms_hash: "terms".to_string(),
+        creator_payout: 0,
+        client_payout: 0,
+        creator_pending: 0,
+        client_pending: 0,
+        creator_pending_since_ns: 0,
+        client_pending_since_ns: 0,
+        creator_pending_id: 0,
+        client_pending_id: 0,
+        creator_withdrawn: 0,
+        client_withdrawn: 0,
+        disputed_at_ns: None,
+        dispute_ends_at_ns: None,
+        created_at_ns: T0,
+        ended_at_ns: None,
