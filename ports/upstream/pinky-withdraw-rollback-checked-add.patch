+}
+
+#[test]
+#[should_panic(expected = "payout overflow")]
+fn credit_rejects_an_overflowing_client_payout() {
+    let mut deal = shell_deal();
+    deal.client_payout = u128::MAX - 1;
+    deal.credit(2, T0, T0);
+}
+
+#[test]
+#[should_panic(expected = "liability overflow")]
+fn credit_deal_rejects_an_overflowing_liability() {
+    let mut c = setup();
+    c.deals.insert(1, shell_deal());
+    c.total_liabilities = u128::MAX - 5;
+    c.credit_deal(1, 10);
+}
