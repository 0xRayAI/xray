{
  "keep_days": 7,
  "stall_hours": 6,
  "watcher_gap_hours": 6,
  "mirror_seat": "builder",
  "develop_branches": [
    "develop"
  ],
  "watcher_seats": [
    "reviewer",
    "builder",
    "tester",
    "operator",
    "coord"
  ],
  "aliases": {
    "Reviewer": "reviewer",
    "Builder": "builder",
    "Tester": "tester",
    "Operator": "operator",
    "Coord": "coord",
    "QA": "qa",
    "blinky": "blinky",
    "Growth": "growth",
    "QaOne": "qa-one",
    "Lab Tester: QaOne": "qa-one",
    "QaTwo": "qa-two",
    "Lab Tester: QA two": "qa-two",
    "Triager": "triager",
    "Ticket Triager": "triager",
    "Seat-C": "seat-c",
    "Chat Bot": "chatbot",
    "ChatBot": "chatbot",
    "SEO Researcher": "seo-researcher",
    "SEO Writer": "seo-writer",
    "Offsite Copier": "offsite-copier",
    "Builder-cloud": "builder-cloud",
    "Arch1": "arch1",
    "forge": "forge",
    "critic": "critic",
    "mill": "mill",
    "Blinky": "blinky",
    "herald": "herald",
    "Nibbler": "nibbler",
    "nibbler": "nibbler",
    "sound": "sound",
    "magnet": "magnet"
  },
  "seats": {
    "reviewer": {
      "kinds": [
        "pr_open",
        "pr_update"
      ]
    },
    "builder": {
      "ready": true
    },
    "tester": {
      "merge_bases": [
        "develop"
      ]
    },
    "operator": {
      "kinds": [
        "deploy",
        "deploy_fail",
        "deploy_pending",
        "deploy_hold"
      ],
      "labels": [
        "lab"
      ],
      "needles": [
        "railway",
        "lab",
        "labtest",
        "cloud agent",
        "cloud agents",
        "operator",
        "ops-app"
      ]
    },
    "coord": {
      "stalls": false,
      "watcher_gaps": true,
      "labels": [
        "needs-decision",
        "lead"
      ],
      "needles": [
        "lead",
        "needs-decision"
      ]
    }
  },
  "_note_stalls": "coord stall lines come from the board model (live card, no beat for 60 min: feed/live_board.py), not the 6 h PR#5 scan",
  "extra_seats": {
    "qa-one": {
      "merge_bases": [
        "develop"
      ],
      "reason": "merge to develop (qa-one retest)"
    },
    "qa-two": {
      "merge_bases": [
        "develop"
      ],
      "reason": "merge to develop (qa two retest)"
    },
    "triager": {
      "kinds": [
        "issue_open"
      ],
      "reason": "new issue to triage"
    },
    "growth": {
      "needles": [
        "growth",
        "go-to-market"
      ],
      "reason": "mentions growth"
    },
    "seat-c": {
      "needles": [
        "seat-c"
      ],
      "reason": "mentions seat-c"
    },
    "chatbot": {
      "needles": [
        "chat bot",
        "chatbot"
      ],
      "reason": "mentions chat bot"
    },
    "seo-researcher": {},
    "seo-writer": {},
    "offsite-copier": {},
    "arch1": {
      "needles": [
        "@arch1",
        "arch1 deep-review",
        "deep-review",
        "deep review",
        "gate b"
      ],
      "reason": "deep-review / Gate B ask for Arch1"
    },
    "forge": {
      "merge_bases": [
        "main",
        "bifrost/main"
      ],
      "needles": [
        "@forge",
        "merge ask",
        "deploy ask",
        "run gate b"
      ],
      "reason": "merge / deploy / Gate B run ask, or merge into main or bifrost/main"
    },
    "critic": {
      "kinds": [
        "review_requested"
      ],
      "needles": [
        "@critic",
        "light ask",
        "strict ask",
        "re-light"
      ],
      "reason": "review request or Light / Strict / re-Light ask"
    },
    "mill": {
      "needles": [
        "@mill",
        "implement ask",
        "rebase ask"
      ],
      "reason": "implement / rebase ask for mill"
    },
    "blinky": {
      "needles": [
        "@blinky"
      ],
      "reason": "CoS / board ask for blinky"
    },
    "herald": {
      "needles": [
        "@herald"
      ],
      "reason": "Dist ask for herald"
    },
    "nibbler": {
      "needles": [
        "@nibbler"
      ],
      "reason": "ask for nibbler"
    },
    "sound": {
      "needles": [
        "@sound"
      ],
      "reason": "ask for sound"
    },
    "magnet": {
      "needles": [
        "@magnet"
      ],
      "reason": "hangar / listing ask for magnet"
    }
  },
  "pr_heads": {
    "kinds": ["pr_open", "pr_update"],
    "seats": {"critic": "review ask: new PR or new head", "blinky": "heads-up: new PR or new head"}
  },
  "_note_pr_heads": "every PR open / new head on a watched repo, mention or not; one line per seat per repo#number@sha (inbox_pass.py)",
  "_note_extra_seats": "extra_seats are routed by feed/inbox_pass.py (kinds / merge_bases / needles); SEO seats have keys but no routes yet",
  "_note_builder_cloud": "builder-cloud gets every builder line (mirrored server-side in app/server.mjs) plus nudges to builder; no routes of its own",
  "fallback": {
    "seat": "blinky",
    "from": [
      "arch1",
      "arch1-cloud"
    ]
  },
  "_note_fallback": "#275: actionable events (ACTIONABLE in inbox_pass.py) with no owner seat, or owned only by arch1 / arch1-cloud (no webhook), also go to blinky (CoS). Pulses (prompt, turn, subagent, watcher, cloud agents) never route.",
  "comment_watch": {"kinds": ["pr_comment", "review_comment", "issue_comment"], "author_kinds": ["pr_comment", "review_comment"],
                    "author_reason": "comment on your PR", "seats": {"blinky": "comment watch (CoS)"}},
  "_note_comment_watch": "Every PR/issue comment (incl. merged PRs) routes to blinky, and PR comments also to the PR author's seat (aliases on the author node), mention or not. @-mentions come from the collector's mentions[] (handles only, never bodies)."
}
