<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: copy to ~/Library/LaunchAgents/, replace USERNAME, then launchctl load it. Runs the watcher loop (60s) for arch1. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.burst.live-inbox-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/USERNAME/.burst/bin/live-inbox-watch</string>
    <string>arch1</string>
    <string>60</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>LIVE_URL</key><string>https://bifrost.0xray.dev</string>
    <key>SEAT_KEYS_DIR</key><string>/Users/USERNAME/.burst/seat-keys</string>
    <key>LIVE_CURSORS</key><string>/Users/USERNAME/.burst/cursors</string>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/USERNAME/.burst/live-inbox-watch.log</string>
  <key>StandardErrorPath</key><string>/Users/USERNAME/.burst/live-inbox-watch.log</string>
</dict>
</plist>
