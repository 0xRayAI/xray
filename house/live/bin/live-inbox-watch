#!/usr/bin/env bash
# live-inbox-watch [seat] [interval_s]: poll a seat's inbox for a CLI seat with no webhook (Arch1 on Blaze's Mac).
# Runs `live-inbox <seat>` every interval (default arch1, 60s) and prints any open asks. Never acks: ack with
# `live-inbox <seat> --ack <id>` after the PR receipt for that line. `--ack stale` lists settled lines and waits for `--apply`. `--upto <id>` acks the stored prefix, including live lines. `--ack all` acks every open line. Env: LIVE_URL, SEAT_KEYS_DIR=~/.burst/seat-keys.
# The tool is main's house/live/tools/live-inbox (XRAY_MAIN, or the tools directory beside this script). Not a copy under ~/.burst/bin.
# The cursor folder rule is grok-bot/OP-PROC.md#cursor-folder. The key is never read or printed here.
# An approved exception to the no-local-watchers rule (Arch1's inbox poll; approved by Blaze 2026-10-13).
# Grok hears a printed line only when this script is the host's internal monitor. A launchd job writes
# ~/.burst/live-inbox-watch.log and does not open the chat. LIVE_WATCH_DELTA=1 prints only when the open set changes.
set -u
SEAT="${1:-arch1}"
INTERVAL="${2:-60}"
case "$INTERVAL" in ''|*[!0-9]*) echo "live-inbox-watch: interval must be whole seconds" >&2; exit 2 ;; esac
export LIVE_URL="${LIVE_URL:-https://bifrost.0xray.dev}"
export SEAT_KEYS_DIR="${SEAT_KEYS_DIR:-$HOME/.burst/seat-keys}"
export LIVE_CURSORS="$HOME/.burst/cursors"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -n "${LIVE_INBOX:-}" ]; then
  INBOX="$LIVE_INBOX"
elif [ -n "${XRAY_MAIN:-}" ] && [ -x "$XRAY_MAIN/house/live/tools/live-inbox" ]; then
  INBOX="$XRAY_MAIN/house/live/tools/live-inbox"
else
  case "$HERE" in
    */.burst/bin) echo "live-inbox-watch: set XRAY_MAIN to the main checkout" >&2; exit 2 ;;
  esac
  if [ -x "$HERE/../tools/live-inbox" ]; then
    INBOX="$HERE/../tools/live-inbox"
  else
    echo "live-inbox-watch: set XRAY_MAIN to the main checkout" >&2
    exit 2
  fi
fi
ONCE="${LIVE_WATCH_ONCE:-}"   # set to 1 to poll once and exit (tests)
MAX="${LIVE_WATCH_MAX:-}"     # stop after this many polls (tests)
DELTA="${LIVE_WATCH_DELTA:-}" # 1: print an open set only when it changes (host monitor)
prev=""
npoll=0
backoff=0
while :; do
  out="$("$INBOX" "$SEAT" 2>&1)"; rc=$?
  ts="$(date '+%Y-%m-%d %H:%M:%S %Z')"
  if [ $rc -eq 0 ]; then
    backoff=0
    if [ -n "$out" ]; then
      if [ "$DELTA" != "1" ] || [ "$out" != "$prev" ]; then
        n=$(printf '%s\n' "$out" | grep -c .)
        echo "[$ts] $SEAT: $n open ask(s)"
        printf '%s\n' "$out"
      fi
      prev="$out"
    else
      prev=""
    fi
  elif printf '%s' "$out" | grep -q 'HTTP 401'; then
    backoff=$(( backoff ? backoff * 2 : INTERVAL * 5 )); [ $backoff -gt 3600 ] && backoff=3600
    echo "[$ts] $SEAT: key not registered (401). The server has no SEAT_KEYS entry matching $SEAT.key; ask Blaze in his 1:1. Retrying in ${backoff}s." >&2
  else
    echo "[$ts] $SEAT: $(printf '%s' "$out" | head -1)" >&2
  fi
  npoll=$((npoll + 1))
  [ -n "$ONCE" ] && exit $rc
  [ -n "$MAX" ] && [ "$npoll" -ge "$MAX" ] && exit $rc
  sleep $(( backoff > INTERVAL ? backoff : INTERVAL ))
done
