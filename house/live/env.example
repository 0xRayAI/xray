# Names only. Never commit values. Real values live outside the repo (agent env, chmod-600 files, Railway variables).

# --- box: feed supervisor (feed/supervisor.sh) ---
GITHUB_APP_PRIVATE_KEY=        # ops-app App key; used ONLY by feed/gh-app-token-readonly.mjs (read-only mint)
LIVE_HOME=                     # base dir for releases/ and run/. default /srv/live
MESH_RUN=                      # data dir (feed/, logs/, pids). default /srv/live/run
GITHUB_APP_ID=                 # the read-only App (mint only)
GITHUB_APP_INSTALLATION_ID=    # its installation on your org
LIVE_MESH_UPSTREAM=            # repo root holding house/live-mesh/fetch_feed.py. default: this checkout
LIVE_HEALTH_URLS=            # space-separated /health URLs (status code + time only)
LIVE_MERGE_QUEUE=            # path to merge-queue.md (lab retests)
LIVE_REST_FLOOR=             # stop REST polling below this core remaining (default 1500)
LIVE_GQL_FLOOR=              # stop GraphQL below this remaining
LIVE_BACKFILL_SECONDS=       # backfill time budget per repo per pass
LIVE_RAILWAY_TARGETS=          # JSON [[project_name, project_id, service, [envs]]]; unset = off
# burst-live / service burst-live / production (project id is the Railway project id; do not invent one):
# LIVE_RAILWAY_TARGETS=[["burst-live","<Railway project id for burst-live>","burst-live",["production"]]]

# --- box: pusher (feed/push_to_host.sh) reads $MESH_RUN/.push-env (chmod 600) ---
MESH_URL=
INGEST_SECRET=

# --- Railway service burst-live, set as Railway variables ---
PORT=
MESH_PASSWORD=                 # gated mode only (the default); not needed when the site is public
LIVE_PUBLIC=                   # optional override: 1 = public (no password, no masking), 0 = gated. Default: feed/site.json, else gated
LIVE_SITE_NAME=                # optional display name (default from feed/site.json, else Bifrost)
SESSION_SECRET=
INGEST_SECRET=
APP_PUBLIC_ORIGIN=              # required in production since #286: the board's public https origin (server refuses to start without it)
ARCHIVE_KEY=
MESH_ARCHIVE_WARM_DAYS=        # optional: archive day dirs read at startup (default 2); older days load on first append (#290)
COLLECTOR_STALE_S=            # feed_quiet when the collector feed file is older than this (default 180)
CARD_BEHIND_S=               # cards_behind when card-moving data outruns the board (default 180)
CARD_STALE_S=                # reported only; does not change /healthz ok
DATA_STALE_S=                # reported only; does not change /healthz ok
RAILWAY_TOKEN=               # optional read-only token; collector deploy poll stays off when unset
RAILWAY_PROJECTS=            # optional JSON [{project, projectId, service, environments}]; no default project
# RAILWAY_POLL_S=15            # seconds between deploy polls. Default 15. The collector pass is about 45s, so several LIVE_RAILWAY_TARGETS still wait on that pass.
# Served fleet.as_of and every *_ct (seat last_ct, cloud *_ct, working since_ct, freshness including cards_at) are America/Chicago with the offset and milliseconds. They do not end in Z.
# A close or a merge clears working_on on the seat and in fleet.working. The seat can stay working.
# fleet.cloud.active is true only while open_agents is non-empty. A recent GitHub cloud line does not keep it active.
ARCH1_LAUNCH_ENABLED=        # 1 launches a cloud agent for a real arch1 packet; default off
ARCH1_CLOUD_REPO=            # default https://github.com/0xRayAI/xray
CURSOR_API_KEY=              # required only when ARCH1_LAUNCH_ENABLED=1
CURSOR_WEBHOOK_SECRET=       # optional; webhook stays unregistered when shorter than 32

# --- Railway service (Railway variables; see house/burst/DEPLOY.md) ---
SEAT_KEYS=                     # JSON {seat: sha256hex} from feed/seat_keys.sh publish (hashes only)
GITHUB_READ_TOKEN=             # fine-grained, read-only; only the collector child gets it

# --- seat helpers and external emitter ---
LIVE_URL=                      # the service URL
LIVE_KEY=                      # this seat's key (never the hash)
SEAT_KEYS_DIR=                 # box dir holding <seat>.key files (0700)

# Optional: map your fleet's GitHub logins to page seats (JSON object or path to a JSON file); unknown logins are hidden (set LIVE_SHOW_UNMAPPED=1 to show them as Others).
# LIVE_NODE_MAP={"my-builder[bot]":"Builder"}
# Counted seats for the fleet header. JSON list, or {"seats","board","fold"}, or a path. Unset keeps the example list.
# LIVE_FLEET_SEATS=["Builder","Reviewer"]
# Directory copied onto public/ at the end of deploy.sh (live-config.js, avatars). Not a Railway variable.
# LIVE_PUBLIC_OVERLAY=
# deploy.sh only. Defaults: burst-live, burst-live, /srv/live/deploy.
# LIVE_RAILWAY_PROJECT=
# LIVE_RAILWAY_SERVICE=
# MESH_APP_DEPLOY_DIR=
# seat_keys.sh. Space-separated tokens, or a JSON file (list or {"seats":[...]}).
# SEAT_KEYS_SEATS=
# SEATS_JSON=
# App /health probes for the collector. Unset means no probe.
# COLLECTOR_HEALTH_URLS=

# Holds, nudges, presence, wake, sources. Names only.
# GITHUB_HOLD_LABEL=on-hold
# NO_NUDGE_REPOS=
# JIRA_HOLD_STATUS=On Hold
# JIRA_SITE=
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_PROJECTS=
# JIRA_EXCLUDE=
# SOURCE_ALLOWLIST=
# SEAT_PRESENCE={"builder-cloud":"builder"}
# SEAT_WEBHOOKS=
# UPSTREAM_REPO=                 # leave unset until Blaze names the upstream repo
# HUMAN_ALIASES=htafolla         # comma or space separated human GitHub logins; each maps to Blaze
# COLLECTOR_WATCHDOG_N=3        # restart the feed loop after this many missed COLLECTOR_WATCH_S ticks
# UPSTREAM_PINNED=
# XRAY_OURS=
# NUDGE_L3_S=7200
# HELD_MAX_S=259200
# LIVE_SHOW_UNMAPPED=1
# Activity (#281): emitter dots stay "working" this long after the last call; cloud agents keep their launching seat
# working until LIVE_CLOUD_IDLE_S after the agent's last line (finished/cancel ends it). POST /activity limits are fixed
# in server.mjs: 60 lines/min per seat, 5000 kept, 1 KiB body (ACT_RATE, ACT_KEEP, ACT_MAX_BODY).
# EMITTER_WORKING_S=120
# LIVE_CLOUD_IDLE_S=1200
# LIVE_GH_SEATS=[{"seat":"forge","bot":"forge0x1[bot]","botId":336325122,"org":"0xRayAI"}]   # seat Apps for POST /activity; unset = kit example, every seat 401
# POST /activity: each seat except Builder uses its own SEAT_KEYS entry and may post only as itself (403 seat mismatch).
# Work track. Packet phases: sent, delivered, woken, acked; overdue past NUDGE_L1_S.
# SEAT_DISPLAY_NAMES={"blinky":"Coord"}   # seat id -> lane label. The Work panel and the working_on chip read this. No hardcoded display name.
# WORK_HUMAN_TO=human                      # inbox `to` that parks a packet on the human lane
# WORK_HUMAN_LANE=Waiting on a human       # that lane's label
# SEAT_AGENT_MAP={"bc-mill0001":"mill","bc-nib*":"nibbler"}   # Cursor agent id or id* prefix -> seat
# CURSOR_WEBHOOK_SECRET=                   # HMAC for POST /cursor/webhook; unset or shorter than 32 leaves it unregistered
# LIVE_TURN_OPEN_MIN=20                    # open turn, and a GitHub comment/review/PR/issue by a mapped actor, expire after this many minutes
# GitHub actor -> seat: inbox-roles.json login, fleet-nodes.json, LIVE_NODE_MAP, LIVE_GH_SEATS bot, git:<seat> (SEAT_GIT_NAMES). working_on is repo#number.
# Chain: docs/work-tracking.md (CURSOR_WEBHOOK_SECRET) and docs/activity-upload.md (box uploader).

# Fleet identity (optional). Empty HUMAN_ALIASES credits a non-roster sender to github.
# burst-live: HUMAN_ALIASES=htafolla=Blaze,lead=Blaze
#   htafolla is the human's GitHub login. lead is the box sender node. Do not set blaze0x1 (not a GitHub user).
LIVE_SEAT_IDS=
HUMAN_ALIASES=
LIVE_WINDOW_MIN=15
# Box activity uploader (tools/push_activity.sh; see docs/activity-upload.md). LIVE_URL is the board base URL, named above.
LIVE_INGEST_SECRET=
ACTIVITY_FILE=
