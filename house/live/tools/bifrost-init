#!/usr/bin/env python3
"""bifrost init: first-run routing setup for any Bifrost fleet (#294).

Asks for the fleet's seats and each seat's wake URL, then writes
  feed/routing/inbox-roles.json      every seat gets a route (@seat mention at least; existing rules are kept)
  feed/routing/seat-webhooks.json    the SEAT_WEBHOOKS shape with placeholders only
and fails when any seat has no route. Real wake URLs and keys never land in the repo: set the SEAT_WEBHOOKS
Railway variable (and WAKE_KEY_<SEAT>) on the host yourself.

  bifrost-init                                  interactive
  bifrost-init --seats forge,critic,mill --yes  non-interactive
  bifrost-init --check [--seats a,b]            validate only (seats default: fleet-roster.json, else extra_seats)
  bifrost-init --check --table                  also print the mention audit: seat, mention, login, OK

Mention audit: a seat with a GitHub login in feed/fleet-nodes.json (login -> seat) must have an @<login> needle on its
route, not only its nickname (@arch1 alone never matches a real @arch10x comment). A nickname-only route fails.
Init adds the @<login> needle for every seat that has a login.
"""
import argparse
import json
import re
import sys
from pathlib import Path

FEED = Path(__file__).resolve().parent.parent / "feed"
SEAT_RE = re.compile(r"^[a-z][a-z0-9-]{0,31}$")
PLACEHOLDER = "<set the real URL in the SEAT_WEBHOOKS host variable>"


def logins_by_seat(nodes_path: Path) -> dict[str, list[str]]:
    """seat -> its real GitHub logins ('[bot]' dropped), from fleet-nodes.json (login -> seat)."""
    try:
        nodes = json.loads(nodes_path.read_text())
    except (OSError, ValueError):
        return {}
    out: dict[str, list[str]] = {}
    for login, seat in nodes.items():
        if isinstance(seat, str) and isinstance(login, str):
            out.setdefault(seat.lower(), []).append(re.sub(r"\[bot\]$", "", login).lower())
    return out


def route_mentions(roles: dict, seat: str) -> list[str]:
    rule = (roles.get("extra_seats") or {}).get(seat) or {}
    return [n.lower() for n in rule.get("needles") or [] if isinstance(n, str) and n.startswith("@")]


def mention_audit(roles: dict, seats, logins: dict) -> list[tuple[str, str, str, bool]]:
    """(seat, mentions, login, ok) per seat. ok = no known login, or one @login is on the route."""
    rows = []
    for s in seats:
        ments, have = route_mentions(roles, s), logins.get(s) or []
        ok = not have or any(f"@{l}" in ments for l in have)
        rows.append((s, ",".join(ments) or "-", ",".join(have) or "-", ok))
    return rows


def routed_seats(roles: dict) -> set[str]:
    """Seats some rule can write a line to."""
    out = set()
    for rule in (roles.get("seats") or {}).values():
        if isinstance(rule, dict) and not rule.get("off") and rule.get("seat"):
            out.add(str(rule["seat"]).lower())
    for seat, rule in (roles.get("extra_seats") or {}).items():
        if isinstance(rule, dict) and any(rule.get(k) for k in ("kinds", "needles", "merge_bases")):
            out.add(seat.lower())
    for key in ("pr_heads", "comment_watch"):
        out.update(s.lower() for s in ((roles.get(key) or {}).get("seats") or {}))
    fb = (roles.get("fallback") or {}).get("seat")
    if fb:
        out.add(str(fb).lower())
    return out


def role_targets(roles: dict) -> dict[str, set[str]]:
    """Every seat a rule names -> the rules naming it (kit roles, extra_seats, pr_heads, comment_watch, fallback)."""
    out: dict[str, set[str]] = {}
    for role, rule in (roles.get("seats") or {}).items():
        if isinstance(rule, dict) and not rule.get("off") and rule.get("seat"):
            out.setdefault(str(rule["seat"]).lower(), set()).add(f"seats.{role}")
    for seat, rule in (roles.get("extra_seats") or {}).items():
        if isinstance(rule, dict) and any(rule.get(k) for k in ("kinds", "needles", "merge_bases")):
            out.setdefault(seat.lower(), set()).add("extra_seats")
    for key in ("pr_heads", "comment_watch"):
        for seat in (roles.get(key) or {}).get("seats") or {}:
            out.setdefault(seat.lower(), set()).add(key)
    for seat in [(roles.get("fallback") or {}).get("seat")] + list((roles.get("fallback") or {}).get("from") or []):
        if seat:
            out.setdefault(str(seat).lower(), set()).add("fallback")
    return out


def unknown_targets(roles: dict, seats) -> list[str]:
    """Rules pointing at a seat that is not in the fleet (a line nobody reads)."""
    return sorted(set(role_targets(roles)) - set(seats))


def unrouted(roles: dict, seats) -> list[str]:
    have = routed_seats(roles)
    return sorted(s for s in seats if s not in have)


def add_seats(roles: dict, seats, logins: dict | None = None) -> dict:
    """Give every seat an @mention route (@seat, plus @login when the seat has a GitHub login); keep existing rules."""
    extra = roles.setdefault("extra_seats", {})
    aliases = roles.setdefault("aliases", {})
    for s in seats:
        rule = extra.setdefault(s, {})
        needles = rule.setdefault("needles", [])
        if f"@{s}" not in needles:
            needles.insert(0, f"@{s}")
        for login in (logins or {}).get(s, [])[:1]:
            if f"@{login}" not in needles:
                needles.insert(1, f"@{login}")
        rule.setdefault("reason", f"ask for {s}")
        aliases.setdefault(s, s)
        aliases.setdefault(s.capitalize(), s)
    return roles


def webhooks(seats, wake: dict) -> dict:
    """SEAT_WEBHOOKS template: placeholders and env names only."""
    return {s: {"url": PLACEHOLDER, "key_env": "WAKE_KEY_" + s.upper().replace("-", "_")}
            for s in seats if wake.get(s)}


def default_seats(roles: dict) -> list[str]:
    roster = FEED / "fleet-roster.json"
    try:
        data = json.loads(roster.read_text())
        seats = data.get("seats") if isinstance(data, dict) else data
        if isinstance(seats, list) and seats:
            return [str(s.get("id") if isinstance(s, dict) else s).lower() for s in seats]
    except (OSError, ValueError):
        pass
    return sorted((roles.get("extra_seats") or {}).keys())


def parse_seats(text: str) -> list[str]:
    seats = [s.strip().lower() for s in text.replace(" ", ",").split(",") if s.strip()]
    bad = [s for s in seats if not SEAT_RE.match(s)]
    if bad:
        sys.exit(f"bifrost init: bad seat name(s): {', '.join(bad)} (lowercase letters, digits, '-')")
    return list(dict.fromkeys(seats))


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="bifrost init")
    ap.add_argument("--seats", help="comma-separated seat ids")
    ap.add_argument("--no-wake", default="", help="comma-separated seats with no wake URL (they poll)")
    ap.add_argument("--routing-dir", default=str(FEED / "routing"))
    ap.add_argument("--check", action="store_true", help="validate the routing file only; write nothing")
    ap.add_argument("--table", action="store_true", help="with --check: print seat -> rules")
    ap.add_argument("--nodes", default=str(FEED / "fleet-nodes.json"), help="login -> seat map (mention audit)")
    ap.add_argument("--yes", action="store_true", help="no prompts")
    a = ap.parse_args(argv)
    rdir = Path(a.routing_dir)
    roles_path = rdir / "inbox-roles.json"
    roles = json.loads(roles_path.read_text()) if roles_path.exists() else {}
    logins = logins_by_seat(Path(a.nodes))

    if a.check:
        seats = parse_seats(a.seats) if a.seats else default_seats(roles)
        miss, ghost = unrouted(roles, seats), unknown_targets(roles, seats)
        if miss:
            print(f"bifrost init: FAIL, no route for seat(s): {', '.join(miss)}. Run bifrost init to add them.", file=sys.stderr)
        if ghost:
            print(f"bifrost init: FAIL, rules route to seat(s) not in the fleet: {', '.join(ghost)}", file=sys.stderr)
        rows = mention_audit(roles, seats, logins)
        nick = [r[0] for r in rows if not r[3]]
        if nick:
            print(f"bifrost init: FAIL, nickname-only route (no @login mention) for: {', '.join(nick)}", file=sys.stderr)
        if a.table:
            targets = role_targets(roles)
            print("seat | mention | login | OK")
            for s, m, l, ok in rows:
                print(f"{s} | {m} | {l} | {'OK' if ok else 'FAIL'}  ({', '.join(sorted(targets.get(s, ())))})")
        if miss or ghost or nick:
            return 1
        print(f"bifrost init: routing OK for {len(seats)} seat(s)")
        return 0

    if a.seats:
        seats = parse_seats(a.seats)
    elif a.yes:
        sys.exit("bifrost init: --yes needs --seats")
    else:
        seats = parse_seats(input("Seats (comma-separated ids, e.g. forge,critic,mill): "))
    if not seats:
        sys.exit("bifrost init: no seats given")
    no_wake = set(parse_seats(a.no_wake)) if a.no_wake else set()
    wake = {}
    for s in seats:
        if s in no_wake:
            wake[s] = False
        elif a.yes or a.seats:
            wake[s] = True
        else:
            ans = input(f"Wake URL for {s} (stays out of the repo; blank = polls, no webhook): ").strip()
            if ans and not re.match(r"^https?://", ans):
                sys.exit(f"bifrost init: {s}: wake URL must start with http(s)://")
            wake[s] = bool(ans)

    add_seats(roles, seats, logins)
    miss = unrouted(roles, seats) + unknown_targets(roles, seats) + [r[0] for r in mention_audit(roles, seats, logins) if not r[3]]
    if miss:   # cannot happen after add_seats unless a rule was hand-broken; fail loudly anyway
        print(f"bifrost init: FAIL, unrouted or unknown seat(s): {', '.join(miss)}", file=sys.stderr)
        return 1
    rdir.mkdir(parents=True, exist_ok=True)
    roles_path.write_text(json.dumps(roles, indent=2, ensure_ascii=False) + "\n")
    (rdir / "seat-webhooks.json").write_text(json.dumps(webhooks(seats, wake), indent=2) + "\n")
    print(f"bifrost init: wrote {roles_path} and {rdir / 'seat-webhooks.json'} for {len(seats)} seat(s)")
    print("Next: set SEAT_WEBHOOKS on the host (same shape, real URLs) and WAKE_KEY_<SEAT> for each woken seat.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
