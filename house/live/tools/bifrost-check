#!/usr/bin/env python3
"""bifrost check: the post-deploy test any Bifrost fleet runs (the critic runbook: grok-bot/runbooks/CRITIC.md).

Prints PASS / FAIL / SKIP per rule with the pack OP-PROC line it checks; exits 1 on any FAIL.

Offline rules (always run, no writes):
  routing      every seat routed; every route @-mentions the seat's real GitHub login (bifrost init --check)
  deliver-sim  for each seat, an issue and an @-comment naming it route to that seat's inbox (the kit's own router)
  edit-sim     a comment edited to add an @-mention routes one line to the newly mentioned seat, once (inbox_pass)
  tripwire     an empty board and a stalled board each fire the timed run once per window; at BIFROST_WEEKLY_BURN>=0.75 the empty board stays quiet (the kit's governor.mjs)
  nudge        a stuck line nudges L1 -> L3, then wakes the coordinator once (the kit's server, local, fake seats)
  nodes        every fleet-nodes.json bot login resolves on GitHub (404 fails; same lookup as routing)
  lexicon      every bolded term in the pack OP-PROC and runbooks is defined in grok-bot/LEXICON.md
  names        docs and plates carry none of the stale phrases in tools/bifrost-stale.json

Live rules (need --repo and --target; skipped with --dry-run, which prints what they would do):
  deliver      for each seat, post a real issue and an @-comment on --repo; both lines land in the seat's inbox on --target
  resolve      every login in the routing map resolves on GitHub, as the deployed server reports at --target/routing
  edit         post a plain comment, edit it to add the seat's @-mention; the edit lands as one inbox line (…:edit:<handle>)
  board-page   the board page and /healthz answer 200 with no server error
  board-cards  every open issue/PR on --repo is exactly one card (no missing card, no duplicate card)
  board-owner  each card's owner is a real seat from the routing map
  addressed    the test posts reach no seat they were not addressed to (watch seats excepted: comment watch, PR heads, issue_open)
  ack          ack one of those lines with the seat key, non-interactive; the call must return without any prompt

  bifrost-check --dry-run
  bifrost-check --repo org/sandbox --target https://<host> [--seats a,b] [--wait 240] [--keep]
Live writes go only to --repo (use a sandbox repo) and --target. gh must be signed in as the checking seat's App;
seat keys are read from SEAT_KEYS_DIR (~/.burst/seat-keys/<seat>.key) and never printed.
"""
import argparse, importlib.machinery, importlib.util, json, os, re, subprocess, sys, time, urllib.request, uuid
from pathlib import Path

LIVE = Path(__file__).resolve().parent.parent
FEED = LIVE / "feed"
PACK = LIVE.parent.parent / "grok-bot" / "OP-PROC.md"
ANCHORS = {"routing": "- **Routing.**", "deliver": "- **Two loops.**", "deliver-sim": "- **Two loops.**", "edit-sim": "- **Two loops.**", "edit": "- **Two loops.**", "ack": "- **Ack.**", "resolve": "- **Routing.**", "nodes": "- **Routing.**", "board-page": "- **Card:**", "board-cards": "- **Card:**",
           "board-owner": "- **Card:**", "addressed": "- **Two loops.**",
           "tripwire": "- **Tripwire.**", "nudge": "- **Nudge.**", "names": "- **Names.**", "lexicon": "~Every term here is defined in the [lexicon]"}


def load_init():
    loader = importlib.machinery.SourceFileLoader("bifrost_init", str(LIVE / "tools" / "bifrost-init"))
    spec = importlib.util.spec_from_loader("bifrost_init", loader)
    mod = importlib.util.module_from_spec(spec); loader.exec_module(mod)
    return mod


def opproc_line(rule, pack=PACK):
    try:
        for i, line in enumerate(pack.read_text().splitlines(), 1):
            a = ANCHORS[rule]
            if (a[1:] in line) if a.startswith("~") else line.startswith(a):
                return f"grok-bot/{pack.name}:{i}"
    except OSError:
        pass
    return f"grok-bot/{pack.name}:?"


class Report:
    def __init__(self):
        self.rows = []

    def add(self, rule, status, detail=""):
        self.rows.append((rule, status, detail))
        print(f"{status:4} {rule:11} [{opproc_line(rule)}] {detail}".rstrip(), flush=True)

    @property
    def failed(self):
        return any(s == "FAIL" for _, s, _ in self.rows)


def check_routing(rep, roles, seats, logins, init, nodes=None, resolve=True, scoped=False):
    miss = init.unrouted(roles, seats)
    # --seats scopes the rule to those seats: a route to a roster seat outside the scope is not "unknown" (#310c)
    ghost = init.unknown_targets(roles, set(seats) | set(init.default_seats(roles))) if scoped else init.unknown_targets(roles, seats)
    resolved = init.resolve_logins(roles, seats, Path(nodes)) if resolve and nodes else {}
    gone = [f"{s}={l}" for s, (l, st) in resolved.items() if st == "missing"]
    rows = init.mention_audit(roles, seats, logins)
    nick = [r[0] for r in rows if not r[3]]
    bad = ([f"unrouted {','.join(miss)}"] if miss else []) + ([f"unknown {','.join(ghost)}"] if ghost else []) + \
          ([f"nickname-only {','.join(nick)}"] if nick else []) + ([f"login 404 on GitHub: {', '.join(gone)}"] if gone else [])
    rep.add("routing", "FAIL" if bad else "PASS", "; ".join(bad) or f"{len(seats)} seats" + (" (scoped by --seats)" if scoped else "") + ", mentions match logins")
    return rows


def check_nodes(rep, nodes, init, resolve=True):
    """#305: every login in fleet-nodes.json resolves on GitHub, the same lookup the routing rule uses."""
    try:
        # bot logins only: the seats' App identities, as in routing. Human entries also carry display aliases (Blaze0x1).
        names = [n for n in json.loads(Path(nodes).read_text()) if n.endswith("[bot]")]
    except (OSError, ValueError) as e:
        return rep.add("nodes", "FAIL", f"fleet-nodes not readable: {type(e).__name__}")
    if not resolve:
        return rep.add("nodes", "SKIP", "--no-resolve")
    st = {n: init.gh_user_status(n) for n in names}
    gone, unk = [n for n in names if st[n] == "missing"], [n for n in names if st[n] == "unverified"]
    rep.add("nodes", "FAIL" if gone else "PASS", (f"login 404 on GitHub: {', '.join(gone)}" if gone else f"{len(names)} fleet-nodes bot logins resolve")
            + (f"; unverified (rate limit or network): {', '.join(unk)}" if unk else ""))


def mention_for(seat, roles, logins):
    """The handle a real comment uses: the seat's GitHub login when it has one, else its @seat needle."""
    have = logins.get(seat) or []
    return have[0] if have else seat


def check_deliver_sim(rep, roles, seats, logins):
    sys.path.insert(0, str(FEED))
    import inbox_pass
    miss = []
    for s in seats:
        m = mention_for(s, roles, logins)
        for kind in ("issue_open", "issue_comment"):
            ev = {"kind": kind, "label": f"bifrost check @{m}", "mentions": [m], "repo": "example-org/check", "number": 1,
                  "t_ct": "2026-01-01T00:00:00-06:00", "id": f"sim-{s}-{kind}"}
            got = {l.get("seat") for l in inbox_pass._direct_all(ev, roles) if l}
            if s not in got:
                miss.append(f"{s}/{kind}")
    rep.add("deliver-sim", "FAIL" if miss else "PASS", ("not routed: " + ", ".join(miss)) if miss else f"{len(seats)} seats x issue+comment")


def check_edit_sim(rep, seats, roles, logins):
    import tempfile
    from datetime import datetime, timedelta, timezone
    R, now = "example-org/check", datetime.now(timezone.utc)
    seat = next((x for x in seats if x != ((roles.get("seats") or {}).get("coord") or {}).get("seat")), seats[0] if seats else None)
    if not seat:
        return rep.add("edit-sim", "SKIP", "no seats")
    m = mention_for(seat, roles, logins)
    with tempfile.TemporaryDirectory() as d:
        run = Path(d); (run / "feed").mkdir(); (run / "fleet").mkdir()
        env = dict(os.environ, MESH_RUN=str(run), LIVE_BOARD="off")
        feed = run / "feed" / "live-events.json"
        seed = {"id": f"{R}#1:open", "t_ct": (now - timedelta(minutes=15)).isoformat(), "kind": "pr_open", "repo": R, "number": "1", "label": "seed"}
        cm = {"id": f"{R}!7:comment:1", "t_ct": (now - timedelta(minutes=1)).isoformat(), "kind": "issue_comment", "repo": R,
              "number": "7", "label": "bifrost check comment", "source": "https://github.com/example-org/check/issues/7", "mentions": []}
        step = lambda evs: (feed.write_text(json.dumps({"events": evs})),
                            subprocess.run([sys.executable, "-B", str(FEED / "inbox_pass.py"), "pass"], env=env, capture_output=True, text=True))[1]
        step([seed]); step([seed, cm]); step([seed, dict(cm, mentions=[m])]); step([seed, dict(cm, mentions=[m])])
        f = run / "feed" / "inbox-spool" / f"{seat}.jsonl"
        ids = [json.loads(x)["id"] for x in f.read_text().splitlines()] if f.exists() else []
        hits = [i for i in ids if ":edit:" in i]
    rep.add("edit-sim", "PASS" if len(hits) == 1 else "FAIL", f"{seat}: {len(hits)} edit line(s) for @{m} added on edit (want 1)")


TRIP_JS = r"""
import { createClock } from %s;
import { burnQuiet } from %s;
const W = 1000, c = createClock({ tripMs: W, perSeatMs: 10, now: 0 });
const out = { empty: [], stall: [] };
c.observe('a', 0, { openCards: 0, coord: 'coord' });
for (let t = 100; t < 1900; t += 100) { const r = c.observe('a', t, { openCards: 0, coord: 'coord' }); if (r) out.empty.push(r); }
const s = createClock({ tripMs: W, perSeatMs: 10, now: 0 });
s.observe('b', 0, { openCards: 2, openSeats: ['x'], coord: 'coord' });
for (let t = 100; t < 1900; t += 100) { const r = s.observe('b', t, { openCards: 2, openSeats: ['x'], coord: 'coord' }); if (r) out.stall.push(r); }
out.stallSeats = Object.keys(s.run?.deadlines || {});
const p = createClock({ tripMs: W, perSeatMs: 10, now: 0 });
p.observe('c', 0, { openCards: 2, openSeats: ['x'], coord: 'coord', planDue: true });
out.plan = [];
for (let t = 100; t < 1900; t += 100) { const r = p.observe('c', t, { openCards: 2, openSeats: ['x'], coord: 'coord', planDue: true }); if (r) out.plan.push(r); }
out.planSeats = Object.keys(p.run?.deadlines || {});
const burnRaw = process.env.BIFROST_WEEKLY_BURN;
const burnN = Number(burnRaw);
const burnFrac = Number.isFinite(burnN) && burnN >= 0 ? (burnN > 1 ? burnN / 100 : burnN) : 0;
if (burnRaw !== '0.75' || !burnQuiet(burnFrac)) throw new Error('BIFROST_WEEKLY_BURN=0.75 did not quiet');
const q = createClock({ tripMs: W, perSeatMs: 10, now: 0 });
q.observe('d', 0, { openCards: 0, coord: 'coord', burnQuiet: true });
out.quiet = [];
for (let t = 100; t < 1900; t += 100) {
  const r = q.observe('d', t, { openCards: 0, coord: 'coord', burnQuiet: burnQuiet(burnFrac) });
  if (r) out.quiet.push(r);
}
out.quietRun = q.run;
console.log(JSON.stringify(out));
"""


def check_tripwire(rep):
    js = TRIP_JS % (
        json.dumps((LIVE / "app" / "governor.mjs").as_uri()),
        json.dumps((LIVE / "app" / "wave-schedule.mjs").as_uri()),
    )
    env = dict(os.environ)
    env["BIFROST_WEEKLY_BURN"] = "0.75"
    r = subprocess.run(["node", "--input-type=module", "-e", js], capture_output=True, text=True, timeout=60, env=env)
    if r.returncode:
        return rep.add("tripwire", "FAIL", "governor did not run: " + r.stderr.strip()[-200:])
    o = json.loads(r.stdout)
    ok = (
        o["empty"] == ["empty"]
        and o["stall"] == ["stall"]
        and o["stallSeats"] == ["x"]
        and o["plan"] == ["stall"]
        and "x" in o["planSeats"]
        and o["quiet"] == ["quiet"]
        and o["quietRun"] is None
    )
    rep.add(
        "tripwire",
        "PASS" if ok else "FAIL",
        f"empty fired {len(o['empty'])}x, stall fired {len(o['stall'])}x, BIFROST_WEEKLY_BURN=0.75 quiet {len(o.get('quiet', []))}x",
    )


