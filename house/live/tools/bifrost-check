def lexicon_terms(text):
    """Defined terms: every bolded name in the first cell of a lexicon table row, lowercased."""
    out = set()
    for row in re.findall(r"^\|(.+)$", text, re.M):
        cell = row.split("|", 1)[0]
        for term in re.findall(r"\*\*(.+?)\*\*", cell):
            name = term.strip().casefold()
            if name:
                out.add(name)
    return out


def undefined_terms(docs, defined):
    """docs: {name: text} -> sorted 'term (file)' for each bolded term with no lexicon row (trailing ':' '.' and plural 's' ignored)."""
    out = set()
    for name, text in docs.items():
        for t in re.findall(r"\*\*(.+?)\*\*", text):
            k = t.strip().rstrip(":.").strip().casefold()
            if k and k not in defined and not (k.endswith("s") and k[:-1] in defined):
                out.add(f"{k} ({name})")
    return sorted(out)


def check_lexicon(rep, pack_dir):
    pack_dir = Path(pack_dir)
    try:
        defined = lexicon_terms((pack_dir / "LEXICON.md").read_text())
    except OSError:
        return rep.add("lexicon", "FAIL", "no LEXICON.md in the pack")
    docs = {"OP-PROC.md": (pack_dir / "OP-PROC.md").read_text()}
    docs.update({f"runbooks/{f.name}": f.read_text() for f in sorted((pack_dir / "runbooks").glob("*.md"))})
    miss = undefined_terms(docs, defined)
    rep.add("lexicon", "FAIL" if miss else "PASS", ("not in the lexicon: " + "; ".join(miss[:10])) if miss
            else f"{len(defined)} lexicon terms cover every bolded term in {len(docs)} files")


def check_names(rep, stale_file):
    cfg = json.loads(Path(stale_file).read_text())
    phrases = [p.casefold() for p in cfg.get("phrases") or []]
    hits = []
    for rel in cfg.get("paths") or []:
        p = (Path(stale_file).parent.parent / rel).resolve()
        files = [p] if p.is_file() else sorted(p.rglob("*.md")) if p.is_dir() else []
        for f in files:
            for i, line in enumerate(f.read_text(errors="replace").splitlines(), 1):
                low = line.casefold()
                hits += [f"{f.name}:{i} '{ph}'" for ph in phrases if ph in low]
    rep.add("names", "FAIL" if hits else "PASS", ("stale: " + "; ".join(hits[:8])) if hits else f"{len(phrases)} phrases, none found")


def collector_poll_s():
    """The collector's poll interval: COLLECTOR_WATCH_S (server default 45)."""
    try:
        return float(os.environ.get("COLLECTOR_WATCH_S") or 45)
    except ValueError:
        return 45.0


def gh(*args, env=None):
    r = subprocess.run(["gh", *args], capture_output=True, text=True, timeout=60, stdin=subprocess.DEVNULL,
                       env={**os.environ, **env} if env else None)
    if r.returncode:
        raise RuntimeError(f"gh {args[0]} {args[1]}: {r.stderr.strip()[:200]}")
    return r.stdout.strip()


def seat_call(target, seat, method, path, body=None):
    kf = Path(os.environ.get("SEAT_KEYS_DIR", "~/.burst/seat-keys")).expanduser() / f"{seat}.key"
    if not kf.is_file():
        raise RuntimeError(f"no seat key for {seat}")
    req = urllib.request.Request(target.rstrip("/") + path, method=method, data=json.dumps(body).encode() if body is not None else None,
                                 headers={"Authorization": "Bearer " + kf.read_text().strip(), "Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=20) as r:
        return json.loads(r.read().decode() or "{}")


def check_resolve(rep, a):
    if not a.target:
        return rep.add("resolve", "SKIP", "needs --target")
    req = urllib.request.Request(a.target.rstrip("/") + "/routing")
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            body = json.loads(r.read().decode())
    except Exception as e:   # noqa: BLE001
        return rep.add("resolve", "FAIL", f"GET /routing failed: {type(e).__name__}")
    bad = [f"{e['seat']}=@{e['login']} {e['status']}" for e in body.get("seats") or [] if e.get("login") and e.get("status") != "ok"]
    rep.add("resolve", "FAIL" if bad else "PASS", ("does not resolve: " + "; ".join(bad)) if bad else
            f"{sum(1 for e in body.get('seats') or [] if e.get('login'))} logins resolve on GitHub")


KNOWN = " (known: today's per-agent board layout; pending the next-wave card restructure)"


def http_get(url, seat=None):
    h = {}
    if seat:
        kf = Path(os.environ.get("SEAT_KEYS_DIR", "~/.burst/seat-keys")).expanduser() / f"{seat}.key"
        if kf.is_file():
            h["Authorization"] = "Bearer " + kf.read_text().strip()
    req = urllib.request.Request(url, headers=h)
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return r.status, r.read().decode(errors="replace")
    except urllib.error.HTTPError as e:
        return e.code, ""
    except Exception:   # noqa: BLE001
        return 0, ""


def board_findings(cards, open_items, aliases):
    """-> (missing, dupes, bad_owner) from /cards cards and the repo's open [(repo, number)]."""
    count = {}
    for c in cards:
        k = (str(c.get("repo") or "").casefold(), int(c.get("number") or 0))
        count[k] = count.get(k, 0) + 1
    missing = [f"{r}#{n}" for r, n in open_items if count.get((r.casefold(), n), 0) == 0]
    dupes = [f"{r}#{n} x{v}" for (r, n), v in count.items() if v > 1]
    bad = [f"{c.get('repo')}#{c.get('number')} owner={c.get('owner')!r}" for c in cards
           if str(c.get("state") or "") != "closed" and str(c.get("owner") or "").removesuffix("[bot]").casefold() not in aliases]
    return missing, dupes, bad


def check_board(rep, a, roles, coord):
    if not a.target:
        for r in ("board-page", "board-cards", "board-owner"):
            rep.add(r, "SKIP", "needs --target" + (" and --repo" if r == "board-cards" else ""))
        return
    t = a.target.rstrip("/")
    st_page, _ = http_get(t + "/")
    st_h, hb = http_get(t + "/healthz")
    ok = st_page in (200, 302) and st_h == 200
    rep.add("board-page", "PASS" if ok else "FAIL", f"/ {st_page}, /healthz {st_h}")
    st, body = http_get(t + "/cards?seat=all", coord)
    try:
        cards = json.loads(body).get("cards") or [] if st == 200 else None
    except ValueError:
        cards = None
    if cards is None:
        rep.add("board-cards", "FAIL", f"/cards?seat=all answered {st}")
        rep.add("board-owner", "FAIL", f"/cards?seat=all answered {st}")
        return
    sys.path.insert(0, str(FEED))
    import inbox_pass
    aliases = {k.casefold() for k in inbox_pass.aliases_of(roles)} | {s.casefold() for s in (roles.get("routing") or {})} | {s.casefold() for s in (roles.get("extra_seats") or {})}
    open_items = []
    if a.repo:
        for what in ("issue", "pr"):
            try:
                open_items += [(a.repo, int(x["number"])) for x in json.loads(gh(what, "list", "--repo", a.repo, "--state", "open",
                                                                                 "--limit", "200", "--json", "number") or "[]")]
            except (RuntimeError, ValueError) as e:
                rep.add("board-cards", "FAIL", f"gh {what} list: {e}"); break
        else:
            cards_repo = [c for c in cards if str(c.get("repo") or "").casefold() == a.repo.casefold()]
            missing, dupes, _ = board_findings(cards_repo, open_items, aliases)
            msg = "; ".join(([f"no card: {', '.join(missing[:8])}"] if missing else []) + ([f"duplicate: {', '.join(dupes[:8])}"] if dupes else []))
            rep.add("board-cards", "FAIL" if msg else "PASS", (msg + KNOWN) if msg else f"{len(open_items)} open items, one card each")
    else:
        rep.add("board-cards", "SKIP", "needs --repo")
    _, _, bad = board_findings(cards, [], aliases)
    rep.add("board-owner", "FAIL" if bad else "PASS", ("owner not in the routing map: " + "; ".join(bad[:8]) + KNOWN) if bad else f"{len(cards)} cards, owners are map seats")


def watch_seats(roles):
    out = set((roles.get("comment_watch") or {}).get("seats") or {}) | set((roles.get("pr_heads") or {}).get("seats") or {})
    out |= {s for s, r in (roles.get("extra_seats") or {}).items() if isinstance(r, dict) and "issue_open" in (r.get("kinds") or [])}
    return out


def check_live(rep, a, roles, seats, logins, dry):
    nolog = [x for x in seats if not logins.get(x)]
    if nolog:   # a bare @seat is somebody else's GitHub handle: never post it
        print(f"     no GitHub login (inner loop only, not posted): {', '.join(nolog)}")
    seats = [x for x in seats if logins.get(x)]
    if dry or not (a.repo and a.target):
        why = "dry-run" if dry else "needs --repo and --target"
        for s in seats:
            print(f"     would: post issue + @{mention_for(s, roles, logins)} comment on {a.repo or '<repo>'}, "
                  f"poll {a.target or '<target>'}/inbox/{s} for both lines")
        rep.add("deliver", "SKIP", why)
        rep.add("edit", "SKIP", why)
        rep.add("addressed", "SKIP", why)
        rep.add("ack", "SKIP", why)
        return
    nonce, posted, missing, edits, selfskip = uuid.uuid4().hex[:8], {}, [], [], []
    alt = os.environ.get(a.alt_token_env, "").strip() if a.alt_token_env else ""
    for s in seats:
        # #310b: a seat never gets a line for its own post. When the checking seat is the target, post as the
        # alternate seat (its token in --alt-token-env, never printed) or mark this seat SKIP instead of FAIL.
        env = None
        if a.self_seat and s == a.self_seat:
            if not alt:
                selfskip.append(s)
                print(f"     {s}: checking seat is the delivery target; no --alt-token-env poster, SKIP")
                continue
            env = {"GH_TOKEN": alt}
        m = mention_for(s, roles, logins)
        url = gh("issue", "create", "--repo", a.repo, "--title", f"bifrost check {nonce} {s}", "--body", f"bifrost check for @{m}", env=env)
        num = int(url.rstrip("/").rsplit("/", 1)[-1])
        gh("issue", "comment", str(num), "--repo", a.repo, "--body", f"@{m} bifrost check comment", env=env)
        plain = gh("issue", "comment", str(num), "--repo", a.repo, "--body", "bifrost check comment, mention added on edit", env=env)
        cid = plain.rsplit("issuecomment-", 1)[-1] if "issuecomment-" in plain else ""
        if cid.isdigit():
            edits.append((cid, m, env))
        posted[s] = num
    if edits:
        # #310a: let the collector see the plain comment first (one poll), else the first sighting already carries the mention
        print(f"     waiting {a.edit_delay}s (collector poll + 5) before editing", flush=True)
        time.sleep(a.edit_delay)
        for cid, m, env in edits:
            gh("api", "-X", "PATCH", f"repos/{a.repo}/issues/comments/{cid}", "-f", f"body=bifrost check edit @{m}", env=env)
    seats = [x for x in seats if x not in selfskip]
    deadline, found = time.time() + a.wait, {}
    while time.time() < deadline and len(found) < len(seats):
        for s, num in posted.items():
            if s in found:
                continue
            try:
                lines = seat_call(a.target, s, "GET", f"/inbox/{s}").get("lines") or []
            except Exception as e:   # noqa: BLE001 - reported per seat below
                lines = []
            mine = [l for l in lines if l.get("number") == num and a.repo.casefold() in str(l.get("repo", "")).casefold()]
            kinds = {str(l.get("type") or l.get("kind") or "") for l in mine}
            if any(k.startswith("issue") and "comment" not in k for k in kinds) and any("comment" in k for k in kinds) \
                    and any(":edit:" in str(l.get("id")) for l in mine):
                found[s] = mine
        time.sleep(15)
    missing = [f"{s}#{posted[s]}" for s in seats if s not in found]
    stray = []
    watch = watch_seats(roles)
    for other in seats:
        if other in watch:
            continue
        try:
            lines = seat_call(a.target, other, "GET", f"/inbox/{other}").get("lines") or []
        except Exception:   # noqa: BLE001
            continue
        stray += [f"{s}#{num}->{other}" for s, num in posted.items() if s != other
                  and any(l.get("number") == num and a.repo.casefold() in str(l.get("repo", "")).casefold() for l in lines)]
    rep.add("addressed", "FAIL" if stray else "PASS", ("reached an unaddressed seat: " + ", ".join(stray[:8])) if stray else "no stray lines")
    rep.add("edit", "SKIP" if not posted else ("FAIL" if missing else "PASS"), "edit line checked with deliver")
    note = f"; self-delivery SKIP: {', '.join(selfskip)}" if selfskip else ""
    rep.add("deliver", "FAIL" if missing else ("SKIP" if not posted else "PASS"),
            (("no issue+comment+edit line for " + ", ".join(missing)) if missing else f"{len(seats)} seats on {a.repo}") + note)
    if found:
        s, lines = next(iter(found.items()))
        t0 = time.time()
        try:
            r = seat_call(a.target, s, "POST", f"/inbox/{s}/ack", {"id": lines[0]["id"]})
            ok = bool(r.get("ok", True)) and time.time() - t0 < 20
            rep.add("ack", "PASS" if ok else "FAIL", f"{s} acked {lines[0]['id']} non-interactive in {time.time() - t0:.1f}s; "
                    "the running seat confirms no approval card appeared")
        except Exception as e:   # noqa: BLE001
            rep.add("ack", "FAIL", f"ack failed: {type(e).__name__}")
    elif not posted:
        rep.add("ack", "SKIP", "nothing posted (self-delivery SKIP)")
    else:
        rep.add("ack", "FAIL", "no delivered line to ack")
    if not a.keep:
        for num in posted.values():
            try:
                gh("issue", "close", str(num), "--repo", a.repo, "--reason", "not planned")
            except RuntimeError:
                pass


def main(argv=None):
    ap = argparse.ArgumentParser(prog="bifrost check")
    ap.add_argument("--repo", help="owner/name the live steps post the test issues on (a sandbox repo)")
    ap.add_argument("--target", help="Bifrost server URL whose inboxes are checked")
    ap.add_argument("--seats", help="comma-separated seats (default: fleet-roster.json)")
    ap.add_argument("--routing-dir", default=str(FEED / "routing"))
    ap.add_argument("--nodes", default=str(FEED / "fleet-nodes.json"))
    ap.add_argument("--stale", default=str(LIVE / "tools" / "bifrost-stale.json"))
    ap.add_argument("--pack", default=str(PACK.parent), help="pack dir holding OP-PROC.md, LEXICON.md, runbooks/")
    ap.add_argument("--no-resolve", action="store_true", help="skip the GitHub users API lookup in the routing rule")
    ap.add_argument("--wait", type=int, default=240, help="seconds to wait for the collector to route the live posts")
    ap.add_argument("--edit-delay", type=float, default=None,
                    help="seconds between the plain comment and its edit (default: collector poll COLLECTOR_WATCH_S + 5 = 50)")
    ap.add_argument("--self-seat", default=os.environ.get("BIFROST_SEAT"), help="the seat running the check (default $BIFROST_SEAT)")
    ap.add_argument("--alt-token-env", help="env var holding another seat's token to post the checking seat's own delivery")
    ap.add_argument("--keep", action="store_true", help="leave the test issues open")
    ap.add_argument("--dry-run", action="store_true", help="no live writes; print what the live steps would do")
    ap.add_argument("--only", help="comma-separated rule names to run")
    a = ap.parse_args(argv)
    if a.edit_delay is None:
        a.edit_delay = collector_poll_s() + 5
    init = load_init()
    roles = json.loads((Path(a.routing_dir) / "inbox-roles.json").read_text())
    seats = init.parse_seats(a.seats) if a.seats else init.default_seats(roles)
    logins = init.seat_logins(roles, Path(a.nodes))
    only = set(a.only.split(",")) if a.only else None
    want = lambda r: only is None or r in only
    rep = Report()
    if want("routing"): check_routing(rep, roles, seats, logins, init, a.nodes, not a.no_resolve, scoped=bool(a.seats))
    if want("nodes"): check_nodes(rep, a.nodes, init, not a.no_resolve)
    if want("deliver-sim"): check_deliver_sim(rep, roles, seats, logins)
    if want("edit-sim"): check_edit_sim(rep, seats, roles, logins)
    if want("tripwire"): check_tripwire(rep)
    if want("nudge"): check_nudge(rep)
    if want("lexicon"): check_lexicon(rep, a.pack)
    if want("names"): check_names(rep, a.stale)
    if want("resolve"): check_resolve(rep, a)
    if any(want(r) for r in ("board-page", "board-cards", "board-owner")):
        check_board(rep, a, roles, ((roles.get("seats") or {}).get("coord") or {}).get("seat"))
    if want("deliver") or want("ack"): check_live(rep, a, roles, seats, logins, a.dry_run)
    print("bifrost check: " + ("FAIL" if rep.failed else "PASS"))
    return 1 if rep.failed else 0


if __name__ == "__main__":
    sys.exit(main())
