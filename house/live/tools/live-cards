#!/usr/bin/env python3
"""live-cards <seat>: the Live board cards <seat> owns or is next owner on (coord / operator: all), one JSON object per
line, with nudge beats. Key: ~/.burst/seat-keys/<seat>.key (SEAT_KEYS_DIR; never printed); LIVE_URL defaults to burst-live."""
import json, os, re, sys, urllib.error, urllib.parse, urllib.request
from pathlib import Path
URL = os.environ.get("LIVE_URL", "https://burst-live-production.up.railway.app").rstrip("/")
KEYS = Path(os.environ.get("SEAT_KEYS_DIR", "~/.burst/seat-keys")).expanduser()
if len(sys.argv) != 2 or not re.fullmatch(r"[a-z0-9-]{2,16}", sys.argv[1]):
    sys.exit("usage: live-cards <seat>")
seat = sys.argv[1]
kf = KEYS / f"{seat}.key"
if not kf.is_file():
    sys.exit(f"no key for seat {seat!r}")
req = urllib.request.Request(f"{URL}/cards?seat={urllib.parse.quote(seat)}", headers={"Authorization": "Bearer " + kf.read_text().strip()})
try:
    with urllib.request.urlopen(req, timeout=20) as r:
        cards = json.loads(r.read().decode()).get("cards") or []
except urllib.error.HTTPError as e:
    sys.exit(f"live-cards: HTTP {e.code}")
except (urllib.error.URLError, TimeoutError) as e:
    sys.exit(f"live-cards: server unreachable ({e})")
for c in cards:
    print(json.dumps(c, ensure_ascii=False))
