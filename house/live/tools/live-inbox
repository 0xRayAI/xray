#!/usr/bin/env python3
"""live-inbox <seat> [--peek] | live-inbox <seat> --ack <id|all> | live-inbox <seat> --pop <id|all>
live-inbox <seat> --handoff <to> --pr <owner/repo#n> --kind <ready|critic_fail|live_pass|merge|ci_fail> [--sha <head>]

Read: OPEN lines from the Bifrost server inbox for <seat>, one JSON object per line on stdout. The server hides lines the
seat acked and lines whose card moved past the seat's step (closed card; for reviewer, a Reviewer verdict at the card's head).
A read never acks. The ack is the receipt (the pop) and a seat sends it after it handles the line, with
--ack or --pop <id> (one line) or --ack all / --pop all (everything open). --peek means the same as a plain read.
The local cursor still advances to the newest line seen.

Handoff: POST one packet to /inbox for <to> and print the one-line 1:1 message the seat sends. The same pull request
and head post the same line id, so a repeat does not store a second packet. A room post is not this command.

Defaults (no env needed): LIVE_URL=https://burst-live-production.up.railway.app, key
~/.burst/seat-keys/<seat>.key (SEAT_KEYS_DIR, never printed), cursor ~/.burst/cursors/<seat>.txt (LIVE_CURSORS)."""
import datetime, json, os, re, sys, urllib.error, urllib.request
from pathlib import Path
URL = os.environ.get("LIVE_URL", "https://burst-live-production.up.railway.app").rstrip("/")
KEYS = Path(os.environ.get("SEAT_KEYS_DIR", "~/.burst/seat-keys")).expanduser()
CUR = Path(os.environ.get("LIVE_CURSORS", "~/.burst/cursors")).expanduser()
KINDS = ("ready", "critic_fail", "live_pass", "merge", "ci_fail")
USAGE = ("usage: live-inbox <seat> [--peek] | live-inbox <seat> --ack <id|all> | "
         "live-inbox <seat> --handoff <to> --pr <owner/repo#n> --kind <" + "|".join(KINDS) + "> [--sha <head>]")
argv = sys.argv[1:]


def take(flag):
    if flag not in argv:
        return None
    i = argv.index(flag)
    if i + 1 >= len(argv) or argv[i + 1].startswith("--"):
        sys.exit(USAGE)
    value = argv[i + 1]
    del argv[i:i + 2]
    return value


ack = None
for flag in ("--ack", "--pop"):
    if flag in argv:
        i = argv.index(flag)
        if i + 1 >= len(argv):
            sys.exit(USAGE)
        ack = argv[i + 1]
        del argv[i:i + 2]
        break
handoff_to = take("--handoff")
pr_raw = take("--pr")
kind = take("--kind")
sha = take("--sha")
if "--peek" in argv:
    argv.remove("--peek")
if any(a.startswith("--") for a in argv):
    sys.exit(USAGE)
args = [a for a in argv if not a.startswith("--")]
if len(args) != 1 or not re.fullmatch(r"[a-z0-9-]{2,16}", args[0]):
    sys.exit(USAGE)
seat = args[0]
if sha is not None and handoff_to is None:
    sys.exit(USAGE)
if (handoff_to is None) != (pr_raw is None or kind is None) or (ack is not None and handoff_to is not None):
    sys.exit(USAGE)
if handoff_to is not None:
    if not re.fullmatch(r"[a-z0-9-]{2,16}", handoff_to) or kind not in KINDS:
        sys.exit(USAGE)
    if sha is not None and not re.fullmatch(r"[0-9a-fA-F]{7,64}", sha):
        sys.exit(USAGE)
    m = re.fullmatch(r"([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)#([1-9]\d{0,6})", pr_raw)
    if not m:
        sys.exit(USAGE)
    repo, number = m.group(1), int(m.group(2))
kf = KEYS / f"{seat}.key"
if not kf.is_file():
    sys.exit(f"no key for seat {seat!r} (builder reads with its builder-app token on its own Mac)")
H = {"Authorization": "Bearer " + kf.read_text().strip()}


def call(method, path, body=None):
    req = urllib.request.Request(URL + path, data=json.dumps(body).encode() if body is not None else None, method=method,
                                 headers={**H, **({"Content-Type": "application/json"} if body is not None else {})})
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return json.loads(r.read().decode())
    except urllib.error.HTTPError as e:
        sys.exit(f"live-inbox: HTTP {e.code} {e.read().decode()[:200]}")
    except (urllib.error.URLError, TimeoutError) as e:
        sys.exit(f"live-inbox: server unreachable ({e})")


if handoff_to is not None:
    head = (sha or "head").lower()
    line_id = f"handoff:{repo.lower()}#{number}:{kind}:{head}"
    url = f"https://github.com/{repo}/pull/{number}"
    line = {"id": line_id, "t_ct": datetime.datetime.now(datetime.timezone.utc).isoformat(),
            "seat": handoff_to, "from": seat, "to": handoff_to, "type": "packet", "kind": kind,
            "repo": repo, "number": number, "title": f"handoff {kind}", "url": url, "reason": f"handoff {kind}"}
    if sha:
        line["sha"] = sha.lower()
    call("POST", "/inbox", {"lines": [line]})
    head_note = f" @{sha[:7].lower()}" if sha else ""
    print(f"SendToAgent {handoff_to}: handoff {kind} {repo}#{number}{head_note} {url}")
    sys.exit(0)
if ack is not None:
    r = call("POST", f"/inbox/{seat}/ack", {"all": True} if ack == "all" else {"id": ack})
    print(json.dumps(r))
    sys.exit(0)
cf = CUR / f"{seat}.txt"
lines = call("GET", f"/inbox/{seat}").get("lines") or []
for l in lines:
    print(json.dumps(l, ensure_ascii=False))
if lines:   # remember the newest line seen; the ack stays explicit
    CUR.mkdir(parents=True, exist_ok=True)
    tmp = cf.with_suffix(".tmp"); tmp.write_text(lines[-1]["id"] + "\n"); os.replace(tmp, cf)
