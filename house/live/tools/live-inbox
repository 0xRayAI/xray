#!/usr/bin/env python3
"""live-inbox <seat> [--peek] | live-inbox <seat> --ack <id|all> | live-inbox <seat> --pop <id|all> | live-inbox <seat> --turn start|end [--tag <tag>] | live-inbox <seat> --prompt [--from <name>] [--room <name>]

Read: OPEN lines from the Bifrost server inbox for <seat>, one JSON object per line on stdout. The server hides lines the
seat acked and lines whose card moved past the seat's step (closed card; for reviewer, a Reviewer verdict at the card's head).
A read never acks. The ack is the receipt (the pop) and a seat sends it after it handles the line, with
--ack or --pop <id> (one line) or --ack all / --pop all (everything open). --peek means the same as a plain read.
The local cursor still advances to the newest line seen.
--turn start|end posts {kind:turn, action, t_ct, tag?} to POST /activity.
--prompt posts {t_ct, seat, kind:prompt, action:sent, from, to:seat, room?} to POST /activity. from defaults to blaze.
t_ct is America/Chicago with its offset. Both posts use the seat key. The key is never printed. There is no local file.
Defaults (no env needed): LIVE_URL=https://burst-live-production.up.railway.app, key
~/.burst/seat-keys/<seat>.key (SEAT_KEYS_DIR, never printed), cursor ~/.burst/cursors/<seat>.txt (LIVE_CURSORS)."""
import json, os, re, sys, urllib.error, urllib.parse, urllib.request
from datetime import datetime
from pathlib import Path
from zoneinfo import ZoneInfo
URL = os.environ.get("LIVE_URL", "https://burst-live-production.up.railway.app").rstrip("/")
KEYS = Path(os.environ.get("SEAT_KEYS_DIR", "~/.burst/seat-keys")).expanduser()
CUR = Path(os.environ.get("LIVE_CURSORS", "~/.burst/cursors")).expanduser()
USAGE = "usage: live-inbox <seat> [--peek] | live-inbox <seat> --ack <id|all> | live-inbox <seat> --pop <id|all> | live-inbox <seat> --turn start|end [--tag <tag>] | live-inbox <seat> --prompt [--from <name>] [--room <name>]"
TAG = re.compile(r"[A-Za-z0-9 ._:@#+/-]{1,40}")
argv = sys.argv[1:]


def take(flag):
    if flag not in argv:
        return None
    i = argv.index(flag)
    if i + 1 >= len(argv) or argv[i + 1].startswith("--"):
        sys.exit(USAGE)
    val = argv[i + 1]
    del argv[i:i + 2]
    return val


ack = None
for flag in ("--ack", "--pop"):
    if flag in argv:
        i = argv.index(flag)
        if i + 1 >= len(argv):
            sys.exit(USAGE)
        ack = argv[i + 1]; del argv[i:i + 2]
        break
turn = take("--turn")
tag = take("--tag")
frm = take("--from")
room = take("--room")
prompt = "--prompt" in argv
if prompt:
    argv.remove("--prompt")
args = [a for a in argv if not a.startswith("--")]
if len(args) != 1 or not re.fullmatch(r"[a-z0-9-]{2,16}", args[0]):
    sys.exit(USAGE)
if tag is not None and turn is None:
    sys.exit(USAGE)
if turn is not None and (ack is not None or prompt or turn not in ("start", "end")):
    sys.exit(USAGE)
if prompt and ack is not None:
    sys.exit(USAGE)
if (frm is not None or room is not None) and not prompt:
    sys.exit(USAGE)
if prompt and frm is None:
    frm = "blaze"
if tag is not None and not TAG.fullmatch(tag):
    sys.exit("tag must be a short plain id")
if frm is not None and not TAG.fullmatch(frm):
    sys.exit("from must be a short plain id")
if room is not None and not TAG.fullmatch(room):
    sys.exit("room must be a short plain id")
seat = args[0]
kf = KEYS / f"{seat}.key"
if not kf.is_file():
    sys.exit(f"no key for seat {seat!r} (builder reads with its builder-app token on its own Mac)")
H = {"Authorization": "Bearer " + kf.read_text().strip()}


def call(method, path, body=None):
    req = urllib.request.Request(URL + path, data=json.dumps(body).encode() if body is not None else None, method=method,
                                 headers={**H, **({"Content-Type": "application/json"} if body is not None else {})})
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return json.loads(r.read().decode())
    except urllib.error.HTTPError as e:
        sys.exit(f"live-inbox: HTTP {e.code} {e.read().decode()[:200]}")
    except (urllib.error.URLError, TimeoutError) as e:
        sys.exit(f"live-inbox: server unreachable ({e})")


def ct_now():
    return datetime.now(ZoneInfo("America/Chicago")).isoformat(timespec="seconds")


if prompt:
    body = {"t_ct": ct_now(), "seat": seat, "kind": "prompt", "action": "sent", "from": frm, "to": seat}
    if room is not None:
        body["room"] = room
    print(json.dumps(call("POST", "/activity", body)))
    sys.exit(0)
if turn is not None:
    body = {"kind": "turn", "action": turn, "t_ct": ct_now()}
    if tag is not None:
        body["tag"] = tag
    print(json.dumps(call("POST", "/activity", body)))
    sys.exit(0)
if ack is not None:
    r = call("POST", f"/inbox/{seat}/ack", {"all": True} if ack == "all" else {"id": ack})
    print(json.dumps(r))
    sys.exit(0)
cf = CUR / f"{seat}.txt"
lines = call("GET", f"/inbox/{seat}").get("lines") or []
for l in lines:
    print(json.dumps(l, ensure_ascii=False))
if lines:   # remember the newest line seen; the ack stays explicit
    CUR.mkdir(parents=True, exist_ok=True)
    tmp = cf.with_suffix(".tmp"); tmp.write_text(lines[-1]["id"] + "\n"); os.replace(tmp, cf)
