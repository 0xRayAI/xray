if ack == "stale":
    if ack_flag != "--ack":
        sys.exit(USAGE)
    lines = call("GET", f"/inbox/{seat}?stale=1").get("lines") or []
    if not apply:
        for l in lines:
            print(json.dumps(l, ensure_ascii=False))
        print(f"dry run: {len(lines)} stale line(s); pass --apply to ack", file=sys.stderr)
        sys.exit(0)
    acked = 0
    open_n = None
    acked_ids = []
    failed = None
    for l in lines:
        line_id = l.get("id")
        if not isinstance(line_id, str) or not line_id:
            continue
        result = call("POST", f"/inbox/{seat}/ack", {"id": line_id}, exit_on_error=False)
        if result.get("error"):
            failed = result["error"]
            break
        acked += int(result.get("acked") or 0)
        acked_ids.append(line_id)
        if "open" in result:
            open_n = result.get("open")
    receipt = {"ok": failed is None, "acked": acked, "ids": acked_ids}
    if open_n is not None:
        receipt["open"] = open_n
    if failed:
        receipt["error"] = failed
    print(json.dumps(receipt))
    sys.exit(0 if failed is None else 1)
