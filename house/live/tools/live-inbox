if turn is not None:
    # Turn end posts the activity line only. WAKE-ROUTINE step 7 asks
    # "anything new without a card?" and files each card (From, Waiting on, Owner)
    # before this post. A crash still reaches the trap without that question.
    # A wake that lost the lines does not start a turn and does not end the winner's claim.
    # kind: turn only. Cloud launch and finish stay on the cloud-agent hooks.
    if not turn_gate(seat, turn):
        sys.exit(0)
    body = {"kind": "turn", "action": turn, "t_ct": ct_now()}
    if tag is not None:
        body["tag"] = tag
